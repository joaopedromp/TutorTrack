{
  "name": "tutortrack",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop tracker for tutoring sessions and pay periods",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build-desktop.mjs",
    "test": "node test-local.mjs",
    "start": "electron desktop/main.cjs",
    "desktop": "npm run build && npm start",
    "format": "prettier --write src desktop tests *.mjs *.json index.html README.md"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^6.3.0",
    "typescript": "~5.7.2",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "vitest": "^3.2.0",
    "fake-indexeddb": "^6.0.0",
    "electron": "44.4.3",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
